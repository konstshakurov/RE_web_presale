{
  "components": {
    "schemas": {
      "AddUserRequest": {
        "properties": {
          "login": {
            "description": "Логин LDAP; приводится к нижнему регистру, 1..128 символов",
            "title": "Login",
            "type": "string"
          }
        },
        "required": [
          "login"
        ],
        "title": "AddUserRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JiraReloginRequest": {
        "properties": {
          "password": {
            "maxLength": 1024,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "title": "JiraReloginRequest",
        "type": "object"
      },
      "JiraStatus": {
        "properties": {
          "code": {
            "default": "",
            "description": "auth_failed | login_blocked | no_permission | jira_unavailable | not_enabled | jira_error; пусто при ok",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "default": "",
            "description": "Текст отказа Jira как есть (FR-029)",
            "title": "Message",
            "type": "string"
          },
          "state": {
            "description": "ok | blocked (отказ Jira: пароль, права, подтверждение входа) | unavailable (Jira недоступна или вход не включён) | not_checked",
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "title": "JiraStatus",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "login": {
            "maxLength": 128,
            "title": "Login",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "login",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "csrf_token": {
            "description": "Заголовок X-CSRF-Token на изменяющих запросах",
            "title": "Csrf Token",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "ФИО из LDAP (cn); null, если не получено - показывать login",
            "title": "Display Name"
          },
          "jira_status": {
            "$ref": "#/components/schemas/JiraStatus"
          },
          "login": {
            "title": "Login",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/Section"
            },
            "title": "Sections",
            "type": "array"
          }
        },
        "required": [
          "login",
          "role",
          "jira_status",
          "sections",
          "csrf_token"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "PatchUserRequest": {
        "properties": {
          "active": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active"
          },
          "role": {
            "anyOf": [
              {
                "enum": [
                  "user",
                  "admin"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          }
        },
        "title": "PatchUserRequest",
        "type": "object"
      },
      "Section": {
        "properties": {
          "admin_only": {
            "title": "Admin Only",
            "type": "boolean"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "key",
          "title",
          "admin_only"
        ],
        "title": "Section",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "login": {
            "title": "Login",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "login",
          "role",
          "active",
          "created_at",
          "updated_at"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "CsrfToken": {
        "in": "header",
        "name": "X-CSRF-Token",
        "type": "apiKey"
      },
      "SessionCookie": {
        "in": "cookie",
        "name": "re_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "re_web_presale api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/users": {
      "get": {
        "operationId": "list_users_admin_users_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UserOut"
                  },
                  "title": "Response List Users Admin Users Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Требуется вход"
          },
          "403": {
            "description": "Не админ или CSRF"
          }
        },
        "security": [
          {
            "SessionCookie": []
          },
          {
            "CsrfToken": []
          }
        ],
        "summary": "List Users",
        "tags": [
          "admin"
        ]
      },
      "post": {
        "description": "Добавить логин; отозванный снова active=true. Повтор для активного: 200, без изменений.",
        "operationId": "add_user_admin_users_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "201": {
            "description": "Добавлен или возвращён"
          },
          "401": {
            "description": "Требуется вход"
          },
          "403": {
            "description": "Не админ или CSRF"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          },
          {
            "CsrfToken": []
          }
        ],
        "summary": "Add User",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/users/{login}": {
      "patch": {
        "description": "active=false отзывает доступ и немедленно все сессии пользователя (UC-006 1а).",
        "operationId": "patch_user_admin_users__login__patch",
        "parameters": [
          {
            "in": "path",
            "name": "login",
            "required": true,
            "schema": {
              "title": "Login",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Требуется вход"
          },
          "403": {
            "description": "Не админ или CSRF"
          },
          "404": {
            "description": "Нет в списке"
          },
          "409": {
            "description": "Нельзя отозвать или понизить последнего активного администратора"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "SessionCookie": []
          },
          {
            "CsrfToken": []
          }
        ],
        "summary": "Patch User",
        "tags": [
          "admin"
        ]
      }
    },
    "/auth/jira-relogin": {
      "post": {
        "description": "Повторный ввод пароля при истёкшей сессии Jira. Как вход LDAP не проверяется;\nпароль только в памяти запроса, отказ Jira становится jira_status, а не ошибкой HTTP.",
        "operationId": "jira_relogin_auth_jira_relogin_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JiraReloginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "CSRF"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Jira не настроена"
          }
        },
        "security": [
          {
            "SessionCookie": []
          },
          {
            "CsrfToken": []
          }
        ],
        "summary": "Jira Relogin",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "description": "LDAP bind, затем проверка списка допущенных, затем сессия (cookie HttpOnly).",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Неверный логин или пароль, либо нет доступа"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Сервис входа временно недоступен, повторите позже"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "CSRF"
          }
        },
        "security": [
          {
            "SessionCookie": []
          },
          {
            "CsrfToken": []
          }
        ],
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "me_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
