# Шаблон конфигурации клиента Jira для re_web_presale (KON-30).
# Скопируйте в корневой .env и заполните. Значений здесь быть НЕ должно.
#
#   copy src\jira_client\.env.example .env
#
# Файл .env уже исключён из git (.gitignore:9). Никогда не коммитьте его
# и не вставляйте реальные значения в этот шаблон, в код или в отчёты.

# ---------------------------------------------------------------------------
# Подключение
# ---------------------------------------------------------------------------
# Базовый URL экземпляра. Требуется без слэша в конце.
JIRA_BASE_URL=https://jira.simbirsoft.com

# ---------------------------------------------------------------------------
# Режим аутентификации
# ---------------------------------------------------------------------------
# cookie  — заголовок Cookie: JSESSIONID=<token>. Основной режим.
#           Требует готовый сессионный токен (см. JIRA_SESSION_TOKEN).
# basic   — заголовок Authorization: Basic. Только для сервисной учётной
#           записи или для пробы; владелец решил, что техническая учётка
#           не нужна.
JIRA_AUTH_MODE=cookie

# Имя сессионной cookie Jira. Обычное значение для Server 8.13.0 — JSESSIONID.
# Меняйте, только если на экземпляре переопределено имя cookie.
JIRA_SESSION_COOKIE=JSESSIONID

# Токен сессии Jira (только для JIRA_AUTH_MODE=cookie).
# Это СЕССИОННЫЙ ТОКЕН, а не пароль: его можно шифровать и хранить
# по NFR-006. Источники получения описаны в
# architecture/probes/KON-30_jira_probe_report.md.
#
# Если оставить пустым, но заполнить JIRA_USERNAME и JIRA_PASSWORD, то
# живая проба input\jira\probe_raw\probe_live.py сама обменяет их на
# сессионный токен через POST /rest/auth/1/session. Пароль при этом
# остаётся только в памяти процесса и никуда не записывается.
JIRA_SESSION_TOKEN=

# Учётная запись. Нужна для JIRA_AUTH_MODE=basic и для обмена на сессию
# через SessionLoginProvider.login() (вход в приложение, ADR-005).
#
# Пароль приложением НЕ сохраняется: он живёт только в памяти одного
# HTTP-запроса POST /rest/auth/1/session — не попадает в БД, в кэш, в логи
# и в трассировку. В код и в базу попадает исключительно сессионный токен,
# причём зашифрованный (NFR-006).
#
# Заполнять эти поля в .env нужно только для повторяемых выгрузок и
# диагностической пробы; без них чтение по-прежнему работает, если задан
# JIRA_SESSION_TOKEN.
JIRA_USERNAME=
JIRA_PASSWORD=

# ---------------------------------------------------------------------------
# Шифрование секретов (NFR-006)
# ---------------------------------------------------------------------------
# Ключ AES-256-GCM в base64, ровно 32 байта после декодирования.
# Сгенерировать: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Ключ обязан отсутствовать в коде и в репозитории.
JIRA_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Таймауты и TLS (NFR-009: не более 10 с на вызов Jira)
# ---------------------------------------------------------------------------
JIRA_TIMEOUT=10
JIRA_VERIFY_TLS=true