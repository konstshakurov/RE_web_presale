.phase_state

# Python
__pycache__/
*.pyc
*.pyo

# Environment variables (Confluence keys, etc.)
.env
.env.local
#.env.*

# Input materials: transcripts, regulations, confidential client documents
input/*
!input/README.md

# Project artifacts (output/data, output/reports) are versioned in this repo:
# it is the working repository of one product project (re_web_presale), not the
# shared platform. Re-check them for secrets and personal data before each commit.
# Previous generations of those same artifacts, kept by write_json_artifact so a
# damaged file can be restored. Same content, same reason to stay out of the repo.
output/.history/

# Competency 1 re-estimates made after project start — project-specific, not part of the tool
estimate/*
!estimate/.gitkeep

# Generated automatically by: python phase.py <phase>
.mcp.json

# Editor and OS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~

# Local machine-specific / test scratch files.
.claude/statusline-command.sh

# Per-machine Claude Code settings, written by the tool itself. Ignored for the same
# reason: it is machine-specific for every user who clones this.
.claude/settings.local.json

# DevOps (KON-32): local secrets and build artifacts
.env.*
!.env.example
node_modules/
frontend/dist/
.ruff_cache/
.pytest_cache/
secrets/
!backend/app/secrets/

# QA-стенд: локально сгенерированные значения (KON-57/58)
qa/stand/.qa.env
qa/e2e/node_modules/
qa/e2e/test-results/
qa/e2e/playwright-report/
qa/e2e/artifacts/
