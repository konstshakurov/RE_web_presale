# Шаблон /opt/re_web_presale/ops.env (права 600, владелец user). Значения - только на ВМ, не в Git.
# Все переменные необязательны; пусто = умолчание из скриптов. Скрипты и таймеры ставятся ТОЛЬКО на ВМ.

# --- Бэкапы ---
# Каталог бэкапов (решение владельца; по умолчанию /var/backups/re_web_presale)
BACKUP_DIR=
# Лимит места под бэкапы, ГБ (по умолчанию 26 = 20% диска 132 ГБ)
BACKUP_MAX_GB=
# Имя контейнера БД (по умолчанию re_web_presale-db-1)
DB_CONTAINER=

# --- Внешняя копия в корпоративное облако через rclone (необязательно; пусто = выключено) ---
# Облако компании https://cloud.simbirsoft1.com/ (предположительно Nextcloud/ownCloud, WebDAV - не проверено).
# Имя remote из rclone.conf на ВМ (тип webdav, пароль приложения через `rclone obscure`, rclone.conf права 600;
# логин и пароль в ops.env и в репозиторий НЕ вносятся). Значение с двоеточием: корень облака пользователя, например simbircloud:
OFFSITE_RCLONE_REMOTE=
# Папка проекта в облаке (создаётся скриптом при первой выгрузке; внутри daily/ и monthly/)
OFFSITE_REMOTE_DIR=RE_web_presale
# Шифрование перед выгрузкой: none | crypt | gpg. Дампы содержат персональные данные (CV).
# Решение владельца: хранить в контуре без шифрования (OFFSITE_ALLOW_PLAINTEXT=1) либо шифровать gpg/crypt.
# Доступ к папке в облаке ограничить владельцем (infra/backup_monitoring.md, раздел 8).
#   crypt - OFFSITE_RCLONE_REMOTE указывает на remote типа crypt (ключи в rclone.conf на ВМ)
#   gpg   - шифрование публичным ключом OFFSITE_GPG_RECIPIENT; закрытый ключ хранится вне ВМ и вне облака
OFFSITE_ENCRYPT=
OFFSITE_GPG_RECIPIENT=
# Хранение БЕЗ шифрования разрешается только явным значением 1 (решение владельца; сам не включать)
OFFSITE_ALLOW_PLAINTEXT=
# Перед выгрузкой проверять восстановление последних дампов: 1 (по умолчанию) | 0
OFFSITE_RESTORE_CHECK=
# Алерт, если выгрузка не удавалась дольше N часов (по умолчанию 48)
OFFSITE_MAX_AGE_H=

# --- Мониторинг ---
# URL проверки (по умолчанию https://127.0.0.1/health; самоподписанный сертификат допускается)
HEALTH_URL=
# Каталог журнала проверок и отчётов (по умолчанию /var/lib/re_web_presale/monitor)
MONITOR_DIR=
# Автоперезапуск контейнеров в состоянии unhealthy: 1 - да (0 - только алерт). Не чаще 3 раз в час на контейнер.
AUTOHEAL=1
# Файл нерабочих праздничных дней для месячного отчёта (по умолчанию infra/ops/holidays_ru.txt рядом со скриптами)
HOLIDAYS_FILE=

# --- Почта: алерты и месячный отчёт (SMTP_HOST пусто = письма не отправляются, только журнал) ---
# Внутренний relay компании: порт 25, без авторизации и без TLS
SMTP_HOST=relay01.simbirsoft
SMTP_PORT=25
# none (для порта 25 по умолчанию) | starttls | ssl. Пусто = по порту: 25 - none, 465 - ssl, иначе starttls
SMTP_SECURITY=none
# 1 - принудительно STARTTLS (по умолчанию выключен для порта 25)
SMTP_STARTTLS=
# Логин и пароль пусты: тогда авторизация не выполняется. Пароль, если понадобится: здесь (файл 600) или путём в SMTP_PASSWORD_FILE
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASSWORD_FILE=
# Адрес отправителя. ПРОВЕРИТЬ, принимает ли relay этот отправитель (иначе письмо будет отклонено)
SMTP_FROM=re-web-presale@simbirsoft
# 0 - не проверять сертификат SMTP-сервера (для порта 25 без TLS не используется)
SMTP_VERIFY_TLS=
# Получатель алертов и отчёта (несколько - через запятую)
ALERT_EMAIL_TO=konstantin.shakurov@simbirsoft.com
# Получатель только отчёта, если отличается от ALERT_EMAIL_TO
REPORT_EMAIL_TO=

# --- Альтернативные каналы (работают вместе с почтой, если заданы) ---
# Вебхук (POST JSON {"text": "..."}), например чат команды
ALERT_WEBHOOK_URL=
# Либо команда, читающая сообщение со stdin
ALERT_CMD=
# Команда доставки Markdown-отчёта доступности (получает на stdin)
REPORT_CMD=
