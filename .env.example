# AInalyst — шаблон переменных окружения
# Скопируйте в .env и заполните своими значениями:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Confluence — вариант A: Confluence Cloud (Atlassian)
# ---------------------------------------------------------------------------

CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_USERNAME=your@email.com
CONFLUENCE_API_TOKEN=your-api-token         # https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_CLOUD=true
CONFLUENCE_SPACE_KEY=BA                     # ключ пространства по умолчанию, например BA или PROJ

# ---------------------------------------------------------------------------
# Confluence — вариант B: Confluence Server / Data Center
# ---------------------------------------------------------------------------
# Раскомментируйте и заполните вместо варианта A.
# PAT поддерживается начиная с Confluence 7.9+.

# CONFLUENCE_URL=https://wiki.your-company.com
# CONFLUENCE_API_TOKEN=your-personal-access-token
# CONFLUENCE_CLOUD=false
# CONFLUENCE_SPACE_KEY=BA

# ===========================================================================
# re_web_presale (KON-32): локальный стенд. Блок ниже БЕЗ значений.
# ==========================================================================
# Пароль: python -c "import secrets; print(secrets.token_urlsafe(32))"
# APP_ENC_KEY (32 байта в base64): python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Пароли ролей: только символы URL-safe (токен выше подходит), они же подставляются в строки подключения.

# --- PostgreSQL (суперпользователь используется только init-скриптом) ---
POSTGRES_PASSWORD=
# Пароли прикладных ролей (app_rw видит только app_db, cv_rw только cv_db)
APP_RW_PASSWORD=
CV_RW_PASSWORD=

# --- Строки подключения для api/worker ---
# вид: postgresql://app_rw:<APP_RW_PASSWORD>@db:5432/app_db  и  postgresql://cv_rw:<CV_RW_PASSWORD>@db:5432/cv_db
APP_DB_URL=
CV_DB_URL=

# --- Шифрование токенов и ключей (ADR-006) ---
APP_ENC_KEY=
APP_ENC_KEY_ID=

# --- Приложение ---
ADMIN_LOGINS=

# --- LDAP (реальные параметры не названы; для разработки тестовый контейнер) ---
# FreeIPA, открытый ldap:// (TLS не используется - решение заказчика).
# LDAP_BIND_TEMPLATE задан: прямой bind DN из шаблона с паролем пользователя, поиск и
# служебная учётка не нужны. Не задан: поиск по LDAP_USER_FILTER (LDAP_BIND_DN необязателен).
# Значения от Support (09.10): URL ldap://freeipa01.simbirsoft:389/ ;
# шаблон uid={login},cn=users,cn=accounts,dc=simbirsoft,dc=dev ;
# base DN cn=users,cn=accounts,dc=simbirsoft,dc=dev. Вписывать в .env, не сюда.
LDAP_URL=
LDAP_BIND_TEMPLATE=
LDAP_BASE_DN=
LDAP_USER_FILTER=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USE_TLS=
# Фильтр с плейсхолдером {login}, например (uid={login})
# по умолчанию 5; SESSION_TTL_HOURS по умолчанию 8
LDAP_TIMEOUT_SEC=
SESSION_TTL_HOURS=
# false только для http-стенда; пусто = true
SESSION_COOKIE_SECURE=

# --- Тестовый LDAP-контейнер (профиль ldap-test) ---
TEST_LDAP_DOMAIN=
TEST_LDAP_ADMIN_PASSWORD=

# --- Jira и LLM ---
JIRA_BASE_URL=
# Ключ шифрования токенов Jira (32 байта base64), отдельный от APP_ENC_KEY:
# python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
JIRA_TOKEN_ENCRYPTION_KEY=
LLM_BASE_URL=
# Внутренняя Qwen (KON-37): ключ создаёт владелец, в Git не попадает; имя модели для chat/completions
LLM_API_KEY=
LLM_MODEL=
# Срок хранения завершённых задач LLM, дни (по умолчанию 7)
LLM_TASK_TTL_DAYS=

# Лимит файла CV по умолчанию, МБ, 1..10 (по умолчанию 10; значение max_file_mb в app_setting приоритетнее)
CV_MAX_FILE_MB=

# --- Синхронизация Jira (необязательные; пусто = значение по умолчанию из backend/app/sync/settings.py) ---
# Интервал опроса потребностей, сек (по умолчанию 300)
SYNC_NEEDS_INTERVAL_SEC=
# Интервал опроса сотрудников, сек (по умолчанию 3600)
SYNC_EMPLOYEES_INTERVAL_SEC=
# Как скоро заметить новый вход при приостановленном опросе, сек (по умолчанию 15)
SYNC_PAUSE_RECHECK_SEC=
# TTL кэша эпиков и правил клиента, сек (по умолчанию 3600)
SYNC_EPIC_TTL_SEC=
# Глубина первичной загрузки, дней (по умолчанию 183)
SYNC_INITIAL_LOAD_DAYS=
# Пересечение окна опроса, сек (по умолчанию 60)
SYNC_OVERLAP_SEC=
# Часовой пояс Jira для JQL, часы от UTC (по умолчанию 4; допущение)
JIRA_UTC_OFFSET_HOURS=
# Проект и тип задачи потребностей (по умолчанию ANALYTICS / Аналитик)
JIRA_NEED_PROJECT=
JIRA_NEED_ISSUETYPE=
# Проект и тип задачи сотрудников (по умолчанию ANALYTICS / Epic)
JIRA_EMPLOYEE_PROJECT=
JIRA_EMPLOYEE_ISSUETYPE=
# Путь файла-пульса воркера для healthcheck (по умолчанию /tmp/worker.heartbeat; менять вместе с healthcheck)
WORKER_HEARTBEAT_PATH=
# Ключи LLM вводятся в «Настройках» и хранятся зашифрованно; в env не нужны.

# --- Порт proxy на хосте (по умолчанию 8080) ---
PROXY_PORT=
